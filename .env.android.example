# Copy this file to .env.android and fill in your deployed backend URL.
# Used only by `npm run build:android` (vite --mode android).
#
# The native Android WebView has no local dev proxy to fall back on, so every
# AI call (Analyse, outline import, image OCR) needs an absolute URL to your
# deployed backend. Without this set, the app silently calls a same-origin
# relative "/api/ai" that resolves to nothing inside the packaged app.
VITE_API_BASE_URL=https://your-app.vercel.app
