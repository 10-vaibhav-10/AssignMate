<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!--
            Edge-to-edge: allow the WebView to draw behind the status bar and the
            system navigation bar (3-button row or gesture handle at the bottom).

            windowTranslucentStatus     = status bar is transparent; app draws behind it.
            windowTranslucentNavigation = nav bar is transparent; app draws behind it.

            The WebView then exposes the correct env(safe-area-inset-*) CSS variables
            so the React shell can pad its own chrome away from the system UI.
            This also silences the Android 15+ forced-edge-to-edge overlap issue.
        -->
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <!--
            Status bar icon colour: false = white/light icons (ideal for our
            purple/violet gradient header that sits under the transparent status
            bar).  If your app ever shows a fully white header at the top you
            would flip this to true for dark icons instead.
        -->
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>